.godot/
.tools/
.DS_Store
artifacts/*.log
artifacts/*.png
builds/

# Reproducible render intermediates and inspection previews.
models/foot-fa01/output/frames/
models/foot-fa01/previews/

# Local diagnostics, Python bytecode, and Blender backup files.
*.log
__pycache__/
*.py[cod]
*.blend[0-9]*

# Regenerable model exports and delivery archives; retain the game GLB and Blender scene.
models/foot-fa01/output/*.glb
models/foot-fa01/output/*.zip
models/foot-fa01/output/*.mp4

# Generated audits, captures, and galleries stay local. Keep Godot's ignore marker.
/game/workshop/verification/*
!game/workshop/verification/.gdignore
.diffui/

# Silhouette mannequin: keep the sheets, three-quarter and silhouettes; the rest regenerates.
models/silhouette-mannequin/output/*.blend
models/silhouette-mannequin/output/clean-*.png
models/silhouette-mannequin/output/mannequin-front.png
models/silhouette-mannequin/output/mannequin-side.png
models/silhouette-mannequin/output/mannequin-back.png


# Leg LG-01 model: scratch work, regenerable GLBs and Blender backups.
models/leg-lg01/work/
models/leg-lg01/output/*.glb
models/leg-lg01/viewer/*.glb
models/leg-lg01/output/frames/

extends "res://tests/kit/crane_suite.gd"
## Focused machinery/state layer, complementary to the ordinary desktop journey.
func run() -> void:
	await boot()
	expect(crane.validate(crane.capture()).is_empty(),"Initial canonical crane snapshot validates")
	expect(not game.model.placement_error("left_leg","spar",crane.uid,"leg_spar_rack").is_empty(),"M2 rejects direct rack-to-leg beam installation")
	await source_route()
	await aim_action("pick:magnet_a")
	var held = crane.capture()
	expect(not crane.request("pick:magnet_b").is_empty() and crane.capture()==held,"Second endpoint pickup preserves occupied hand atomically")
	expect(not crane.request("attach:unmarked").is_empty() and crane.capture()==held,"Wrong magnetic point rejects without mutation")
	expect(not crane.request("up").is_empty() and crane.capture()==held,"Partial rigging cannot release rack or start a transfer")
	tap(KEY_Q);expect(crane.hand_payload().is_empty(),"Q stows held end without inventory mutation")
	await rig(true)
	var rigged = crane.capture()
	expect(not crane.request("attach:beam_near").is_empty() and crane.capture()==rigged,"Occupied magnetic point preserves both engaged ends")
	await deliver()
	var before = crane.capture()
	expect(not crane.request("detach:magnet_a").is_empty() and crane.capture()==before,"Unsecured flange cannot release crane assistance")
	await console_action("up")
	expect(game.model.items[crane.uid].location == "support:m2_service_crane","Up reacquires support before lifting the beam")
	expect(await settle(),"Reverse axial lift completes")
	await console_action("go:source");expect(await settle(),"Suspended beam returns above rack")
	await console_action("down")
	expect(await settle() and game.model.items[crane.uid].location == "support:leg_spar_rack","Down restores real source ownership")
	expect(crane.attached_count()==2 and is_zero_approx(crane.path),"Return preserves contacts until rack supports load")
	await finish("SERVICE_CRANE","/tmp/service-crane.audit.json")

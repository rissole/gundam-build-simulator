; Gundam Build Simulator workshop prototype
config_version=5

[application]
config/name="Gundam Build Simulator"
run/main_scene="res://scenes/workshop.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
; Keep experiments out of the accepted workshop's save slot.
config/use_custom_user_dir=true
config/custom_user_dir_name="Gundam Build Simulator Visual Spike"
config/description="A robot construction game prototype with manual-guided workshop assembly."
run/max_fps=60

[display]
window/dpi/allow_hidpi=true
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/mode=3
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/positional_shadow/atlas_size=2048
environment/ssao/quality=1
environment/ssao/half_size=true
environment/volumetric_fog/volume_size=64
environment/volumetric_fog/volume_depth=64
environment/defaults/default_clear_color=Color(0.10,0.13,0.16,1)

[physics]
3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[audio]
driver/enable_input=false

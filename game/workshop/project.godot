; Gundam Build Simulator workshop prototype
config_version=5

[application]
config/name="Gundam Build Simulator"
run/main_scene="res://scenes/workshop.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A robot construction game prototype with manual-guided workshop assembly."
run/max_fps=60

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/mode=3
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
environment/defaults/default_clear_color=Color(0.10,0.13,0.16,1)

[physics]
3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[audio]
driver/enable_input=false

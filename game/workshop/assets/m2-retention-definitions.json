      "manual": [
        {
          "title": "Travel, tilt and seat the supported leg",
          "view": "overview",
          "slots": [],
          "body": "The complete leg starts on its home rail; the pelvis socket and retaining connections are empty. Walk the rail controls through travel, tilt and upward docking. The rail seats the hip ball and remains engaged as assistance. Board the personnel lift and use Up. One retaining half and its two washer/bolt pairs are supplied; this example cannot secure the complete hip.",
          "context_sources": [
            "PV-110__001"
          ]
        },
        {
          "title": "Seat one hip retaining half",
          "body": "Collect the two washer/bolt pairs into your pockets at ground level. E picks up PV-120 with both hands. Carry it onto the lift and click the component shelf to store it. The shelf holds two one-hand components or one two-hand component. Ride Up, E-pick the half from the shelf, then aim and click the underside connection of the already seated socket. Either identical half fits.",
          "slots": [
            "ring_1"
          ],
          "view": "components",
          "context_sources": [
            "PV-110__001",
            "PV-V-HIP-BALL"
          ],
          "diagram_views": [
            {
              "title": "Seat one hip retaining half",
              "sources": [
                "PV-120__001"
              ],
              "context": [
                "PV-110__001",
                "PV-V-HIP-BALL"
              ],
              "offsets": {},
              "direction": [
                1,
                1,
                1
              ],
              "up": [
                0,
                1,
                0
              ],
              "context_padding": 0.08
            }
          ]
        },
        {
          "title": "Fasten the supported half",
          "body": "Fit the pocketed LG-W24 washers and PV-H24140 bolts upward through the seated half into the socket flange, each washer before its bolt. Z reverses these steps. Undoing the half returns that same component to your hands at the connection; store it on the lift shelf to bring it down. Retention blocks rail Return until every fitted retention piece is removed.",
          "slots": [
            "ring/washer_3",
            "ring/bolt_3",
            "ring/washer_4",
            "ring/bolt_4"
          ],
          "view": "components",
          "context_sources": [
            "PV-110__001",
            "PV-120__001"
          ],
          "diagram_views": [

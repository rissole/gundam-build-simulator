      "manual": [
        {
          "title": "Supplied horizontal receiving assembly",
          "view": "overview",
          "slots": [],
          "body": "The complete existing foot and the horizontal shin, bearings, spacers, knee fork, axle and cap are supplied on the home rail. The real LG-120 Upper-leg beam remains on its rack; four LG-W24 washers and four LG-H24100 bolts remain loose stock. No beam or flange hardware is preinstalled."
        },
        {
          "title": "Deliver the Upper-leg beam",
          "body": "At the central crane console, choose Go to Upper-leg beam rack, then Down. The console captures the view: click a command or use arrow keys and E; Q closes it. Travel destinations appear only while Up. Walk to its source rack, E-pick a magnetic end and aim/click a free marked point; repeat for the other end. Either end fits either point; Q stows a held end. Return to the console and choose Up, then Go to Leg cradle, then Down. The crane takes the same LG-120 from the rack, reaches the receiving cradle and seats the flange through the final 0.20 m axial approach toward −Z. These horizontal flanges cannot mate by a vertical drop. Keep both cables attached during fastening.",
          "slots": [
            "spar"
          ],
          "view": "components",
          "context_sources": [
            "LG-110__001"
          ],
          "diagram_views": [
            {
              "title": "Deliver the Upper-leg beam",
              "sources": [
                "LG-120__001"
              ],
              "context": [
                "LG-110__001"
              ],
              "offsets": {},
              "direction": [
                1,
                1,
                1
              ],
              "up": [
                0,
                1,
                0
              ],
              "context_padding": 0.08
            }
          ]
        },
        {
          "title": "Fasten the Upper-leg beam flange",
          "body": "Collect four LG-W24 washers and four LG-H24100 bolts normally. On the already seated Upper-leg beam, fit each washer and then its bolt through the four exposed flange corners into the existing fork. On the horizontal assembly, work from the exposed +Z head faces and insert toward −Z. Keep crane assistance until all four pairs are fitted, then detach and stow both magnetic ends and park the empty crane. For recovery before any flange hardware is fitted, Up at the leg cradle removes the supported beam and reverses the axial approach. Choose Go to Upper-leg beam rack, then Down to return it. Undo all fitted flange hardware with Z before lifting a loaded beam.",
          "slots": [
            "fork/washer_1",
            "fork/bolt_1",
            "fork/washer_2",
            "fork/bolt_2",
            "fork/washer_3",
            "fork/bolt_3",
            "fork/washer_4",
            "fork/bolt_4"
          ],
          "view": "components",
          "context_sources": [
            "LG-110__001",
            "LG-120__001"
          ],
          "diagram_views": [
            {
              "title": "Fasten the Upper-leg beam flange",
              "sources": [
                "LG-W24__001",
                "LG-H24100__001",
                "LG-W24__002",
                "LG-H24100__002",
                "LG-W24__003",
                "LG-H24100__003",
                "LG-W24__004",
                "LG-H24100__004"
              ],
              "context": [
                "LG-110__001",
                "LG-120__001"
              ],
              "offsets": {},
              "direction": [
                1,
                1,
                1
              ],
              "up": [
                0,
                1,
                0
              ],
              "context_padding": 0.08
            }
          ]
        },
        {
          "title": "Crane-delivery example complete",
          "view": "prepared",
          "slots": [],
          "body": "The Upper-leg beam is fastened to the supplied horizontal leg and the magnetic ends can be stowed before parking the empty crane. Full released-beam disassembly and the whole leg-to-robot journey remain outside this example."
        }
      ]
    },

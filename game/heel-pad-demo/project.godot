; FA-01 workshop interaction prototype
config_version=5

[application]
config/name="FA-01 • Assembly Workshop"
run/main_scene="res://scenes/workshop.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A manual-guided workshop for heel pads and a complete pitch actuator."

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/mode=3
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.10,0.13,0.16,1)

[physics]
3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[audio]
driver/enable_input=false
